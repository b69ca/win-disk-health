<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>win-disk-health</AssemblyName><Version>1.0.0</Version>
    <DebugType>embedded</DebugType><ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
    <RepositoryUrl>https://github.com/b69ca/win-disk-health</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup><Compile Remove="tests/**/*.cs" /><EmbeddedResource Include="Collector.ps1" /></ItemGroup>
</Project>
